# Copy this file to .env and fill in the two values below.
# Personal API keys are available near the bottom of Intervals.icu Settings.
INTERVALS_API_KEY=
# Use 0 for the athlete belonging to the personal API key, or your i-prefixed ID.
INTERVALS_ATHLETE_ID=0

# Optional overrides
# Leave blank to use the computer's current local date. Set only for reproducible back-testing.
COACH_AS_OF_DATE=
COACH_HISTORY_MONTHS=24
COACH_DETAIL_WEEKS=16
INTERVALS_TIMEOUT_SECONDS=30

# Optional read-only fallback. Import explicitly with:
# python -m src.strava_archive --zip "C:\\path\\to\\export.zip"
STRAVA_ARCHIVE_PATH=

# Web app: copy the relevant values to web/.env.local (never commit it).
# Copy to .env and fill in from Supabase -> Project Settings -> API.
# Without these the app runs in demo mode with local mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
